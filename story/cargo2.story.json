    "trades_completed": 1
   },
   "effects": {
    "money": 500,
    "plot_points": 5
   },
   "source": "data/story.yml",
   "variants": [
    {
     "when": "alternate",
     "text": "The market is unforgiving. Your first transaction was clumsy, but you survived it."
    },
    {
     "when": "default",
     "text": "You have made first steps in commerce."
    },
    {
     "when": "alternate",
     "text": "The market was unforgiving, and you barely made any money."
    },
    {
     "when": "market_crash",
     "text": "You have traded on the market, but there was market crash after you, and you lost money"
